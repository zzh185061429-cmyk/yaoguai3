{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "时间": {
      "type": "object",
      "properties": {
        "当前日期时间": {
          "default": "10月08日 07:30",
          "type": "string",
          "description": "格式为 MM月DD日 HH:mm，例如 10月08日 07:30"
        },
        "当前星期": {
          "default": "周二",
          "type": "string",
          "enum": [
            "周一",
            "周二",
            "周三",
            "周四",
            "周五",
            "周六",
            "周日"
          ]
        }
      }
    },
    "状态": {
      "type": "object",
      "properties": {
        "当前地点": {
          "default": "沈家别墅",
          "type": "string"
        }
      }
    },
    "今日派单": {
      "type": "object",
      "properties": {
        "客户": {
          "default": "待定",
          "type": "string",
          "enum": [
            "温知晚",
            "周念安",
            "傅霁",
            "椎名律",
            "姜朝渔",
            "裴今歌",
            "罗兰",
            "霍千黎",
            "季明舒",
            "步玲燕",
            "陆时予",
            "许不倦",
            "待定"
          ]
        },
        "描述": {
          "default": "待生成",
          "type": "string",
          "description": "客户下单的自然语言描述，符合角色人设"
        },
        "预约时间": {
          "default": "",
          "type": "string",
          "description": "格式 MM月DD日 HH:mm"
        },
        "服务时长": {
          "default": 0,
          "type": "number",
          "description": "服务小时数"
        },
        "价格": {
          "default": 0,
          "type": "number",
          "description": "该单预期收入"
        }
      }
    },
    "经济": {
      "type": "object",
      "properties": {
        "总债务": {
          "default": 300000000,
          "type": "number"
        },
        "累计收入": {
          "default": 0,
          "type": "number"
        },
        "剩余债务": {
          "default": 300000000,
          "type": "number"
        }
      }
    },
    "角色数据": {
      "default": {
        "温知晚": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        },
        "周念安": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        },
        "傅霁": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        },
        "椎名律": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        },
        "姜朝渔": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        },
        "裴今歌": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        },
        "罗兰": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        },
        "霍千黎": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        },
        "季明舒": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        },
        "步玲燕": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        },
        "陆时予": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        },
        "许不倦": {
          "剩余服务小时": 0,
          "剩余服务分钟": 0,
          "服务状态": "无服务"
        }
      },
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "温知晚",
          "周念安",
          "傅霁",
          "椎名律",
          "姜朝渔",
          "裴今歌",
          "罗兰",
          "霍千黎",
          "季明舒",
          "步玲燕",
          "陆时予",
          "许不倦"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "剩余服务小时": {
            "default": 0,
            "type": "number",
            "description": "距离服务结束剩余的小时数，未开始时=服务时长，冻结不变"
          },
          "剩余服务分钟": {
            "default": 0,
            "type": "number",
            "description": "距离服务结束剩余的分钟数"
          },
          "服务状态": {
            "default": "无服务",
            "type": "string",
            "enum": [
              "无服务",
              "未开始",
              "进行中"
            ],
            "description": "无服务→(派单)→未开始→(到预约时间)→进行中→(时间耗尽)→无服务"
          }
        }
      },
      "required": [
        "温知晚",
        "周念安",
        "傅霁",
        "椎名律",
        "姜朝渔",
        "裴今歌",
        "罗兰",
        "霍千黎",
        "季明舒",
        "步玲燕",
        "陆时予",
        "许不倦"
      ]
    }
  },
  "required": [
    "时间",
    "状态",
    "今日派单",
    "经济"
  ]
}